{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.DS_Store",
    "**/node_modules",
    "**/vendor",
    "**/dist",
    "**/build",
    "**/_output",
    "**/coverage",
    "**/.next"
  ],
  "languages": {
    "Markdown": {
      "formatter": {
        "external": {
          "command": "./bin/dprint",
          "arguments": ["fmt", "--stdin", "md"]
        }
      },
      "format_on_save": "on"
    }
  }
}
